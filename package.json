{
  "name": "rocketry-ui",
  "main": "build/electron.js",
  "proxy": "http://localhost:3001",
  "version": "0.1.0",
  "description": "Ground station telemetry and control software for a rocketry project.", 
  "author": "Agneya D A <agneya181222da@gmail.com>",
  "homepage": ".",
  "private": true,
  "build": {
    "appId": "com.rocketry-bmsce.rocketryui",  
    "productName": "Rocketry UI",
    "icon": "app_icon.png", 
    "win": {
      "icon": "app_icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@serialport/binding-mock": "^10.2.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.7.7",
    "chart.js": "^4.4.4",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "leaflet": "^1.9.4",
    "mongodb": "^6.8.1",
    "mongoose": "^8.6.1",
    "path": "^0.12.7",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-confetti": "^6.1.0",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-scripts": "5.0.1",
    "serialport": "^12.0.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "wait-on": "^8.0.4",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject",
    "postbuild": "copy public\\electron.js build\\electron.js",
    "start-electron": "wait-on http://localhost:3000 && electron .",
    "start-server-test": "wait-on http://localhost:3000 && node server.js",
    "start-server": "wait-on http://localhost:3000 && node integrated_server.js",
    "rocket-test": "concurrently \"cross-env BROWSER=none npm start\" \"npm run start-server-test\" \"npm run start-electron \"",
    "rocket-prod": "concurrently \"cross-env BROWSER=none npm start\" \"npm run start-server\" \"npm run start-electron \"",
    "electron:build": "electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "react-app-rewired": "^2.2.1",
    "workbox-webpack-plugin": "^7.3.0"
  }
  
}
